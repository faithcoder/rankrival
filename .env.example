STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Listings and rank updates are free by default. Set to false when payments are ready.
NEXT_PUBLIC_FREE_LISTINGS=true

# Railway: mount a persistent volume at /data and set this to /data.
RANKRIVAL_DATA_DIR=/data
# Generate a private random value (for example: openssl rand -hex 32).
VOTER_HASH_SECRET=replace_with_a_long_random_secret
# Optional for local development only. Never enables mock payments in production.
ALLOW_MOCK_PAYMENTS=false
